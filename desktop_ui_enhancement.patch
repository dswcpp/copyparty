+        button_layout.addWidget(self.test_btn)
+        
+        layout.addLayout(button_layout)
+        
+        self.setLayout(layout)
+
+    def create_webdav_tab(self):
+        """创建WebDAV配置标签页"""
+        widget = QWidget()
+        layout = QVBoxLayout()
+        
+        # WebDAV基本设置
+        webdav_group = QGroupBox("WebDAV 设置")
+        webdav_layout = QGridLayout()
