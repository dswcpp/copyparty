+def init_matplotlib():
+    """延迟初始化matplotlib，避免启动时阻塞"""
+    global MATPLOTLIB_AVAILABLE
+    try:
+        import matplotlib
+        matplotlib.use('Agg')  # 使用非交互式后端
+        import matplotlib.pyplot as plt
+        from matplotlib.figure import Figure
+        MATPLOTLIB_AVAILABLE = True
+        print("✓ matplotlib延迟加载成功")
